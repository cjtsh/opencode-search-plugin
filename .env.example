# ============================================================================
# opencode Web Search Plugin — Environment Variables
# ============================================================================
# Copy this file to `.env` and fill in your real API keys:
#
#     cp .env.example .env
#
# The plugin auto-loads `.env` from (in order, first match wins):
#   1. The directory containing the plugin file
#   2. ~/.config/opencode/.env        (global install)
#   3. The current working directory   (project-local dev)
#
# Shell exports (~/.zshrc, ~/.bashrc) ALWAYS take precedence over .env.
# This file is purely additive — it only fills in keys that aren't already set.
#
# NEVER commit `.env` to git — it contains your real keys.
# `.env` is already in `.gitignore`.
# ============================================================================

# ----------------------------------------------------------------------------
# Brave Search API key (primary backend)
# Free tier: 2,000 queries/month
# Get one at: https://brave.com/search/api/
# ----------------------------------------------------------------------------
BRAVE_API_KEY=your_brave_api_key_here

# ----------------------------------------------------------------------------
# Serper.dev API key (fallback backend, Google-quality results)
# Paid but cheap. Get one at: https://serper.dev/
# ----------------------------------------------------------------------------
SERPER_API_KEY=your_serper_api_key_here

# ----------------------------------------------------------------------------
# Optional behavior overrides
# ----------------------------------------------------------------------------

# Force web_search on/off regardless of model detection.
#   auto (default) — enabled for local models only (ollama, lmstudio, etc.)
#   on             — always enabled, even for hosted models
#   off            — fully disabled, tool returns a friendly message
# WEB_SEARCH_FORCE=auto

# Maximum characters of result text returned to the model.
# Lower this for small-context local models (e.g. 4096-token windows).
# WEB_SEARCH_MAX_CHARS=8000

# Default number of results per search (1-20).
# WEB_SEARCH_MAX_RESULTS=10
